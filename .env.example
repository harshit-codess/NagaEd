# Copy to .env (cp .env.example .env) and adjust. NEVER commit .env.

# --- MySQL ---
MYSQL_DATABASE=nagaed_auth
MYSQL_USER=nagaed_app
MYSQL_PASSWORD=change_this_db_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# --- Node.js API ---
# >= 32 chars. Generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-replace-me-with-openssl-rand-hex-32
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# --- FastAPI AI service ---
# Free key from https://console.groq.com  (leave empty to start without AI; the endpoint will return 503)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Public port of the web app (nginx) ---
WEB_PORT=8080
